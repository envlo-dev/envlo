{
  "name": "@envlo/sandbox",
  "version": "0.0.0",
  "private": true,
  "description": "Cloudflare Email Worker ephemeral sandbox gateway with 2h ring buffer and Concierge Pro Stripe webhook",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "wrangler.toml",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "tsup": "^8.5.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.45.0"
  }
}
