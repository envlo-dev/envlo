{
  "name": "@envlo/core",
  "version": "0.0.0",
  "description": "MIME firewall, DOM sanitizer, and email state engine for AI agents",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./parser": {
      "import": {
        "types": "./dist/parser/index.d.ts",
        "default": "./dist/parser/index.js"
      },
      "require": {
        "types": "./dist/parser/index.d.cts",
        "default": "./dist/parser/index.cjs"
      }
    },
    "./forwarding": {
      "import": {
        "types": "./dist/forwarding/index.d.ts",
        "default": "./dist/forwarding/index.js"
      },
      "require": {
        "types": "./dist/forwarding/index.d.cts",
        "default": "./dist/forwarding/index.cjs"
      }
    },
    "./firewall": {
      "import": {
        "types": "./dist/firewall/index.d.ts",
        "default": "./dist/firewall/index.js"
      },
      "require": {
        "types": "./dist/firewall/index.d.cts",
        "default": "./dist/firewall/index.cjs"
      }
    },
    "./markdown": {
      "import": {
        "types": "./dist/markdown/index.d.ts",
        "default": "./dist/markdown/index.js"
      },
      "require": {
        "types": "./dist/markdown/index.d.cts",
        "default": "./dist/markdown/index.cjs"
      }
    }
  },

  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node ./scripts/runtime-smoke.mjs --expect node",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "email-reply-parser": "^2.3.2",
    "linkedom": "^0.18.12",
    "postal-mime": "^2.6.0",
    "sanitize-html": "^2.18.2",
    "turndown": "^7.2.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/sanitize-html": "^2.16.0",
    "@types/turndown": "^5.0.5",
    "tsup": "^8.5.0",
    "vitest": "^4.1.12"
  }
}
