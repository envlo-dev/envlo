{
  "name": "@envlo/mcp",
  "version": "0.0.0",
  "description": "MCP server exposing Envlo inbox tools over stdio and Streamable HTTP",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "envlo-mcp": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@envlo/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.22.0",
    "imapflow": "^2.12.2",
    "smtp-server": "^3.21.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/smtp-server": "^3.5.13",
    "tsup": "^8.5.0",
    "vitest": "^4.1.12"
  }
}
